# Copy to .env and fill in. On a host, set these as environment variables instead.
BOT_TOKEN=123456:ABC-your-token-from-BotFather

# One-time access codes, comma- or space-separated. Never commit real ones.
# You can also append them to access_codes.txt in DATA_DIR on the server.
ACCESS_CODES=CHANGEME-ONE,CHANGEME-TWO

# Optional: persistent data directory (a mounted volume on a server).
# DATA_DIR=/data

# Optional: only if your network blocks Telegram.
# PROXY_URL=socks5://127.0.0.1:1080
